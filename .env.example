# Gymnasium Docker hosting config. Copy to `.env` and edit.
#
# Leaving TUNNEL_NAME / APP_HOST unset (or commented out) runs LOCAL-ONLY:
# start.sh boots only the app container on http://localhost:$PORT. Setting
# BOTH starts the Cloudflare sidecar and publishes the app at APP_HOST.

# --- Tunnel (set BOTH to publish publicly) ---
TUNNEL_NAME=gymnasium
DOMAIN=marashi.ai
APP_HOST=gymnasium.marashi.ai

# --- App ---
PORT=8000
GYM_MODEL=opencode/big-pickle
# Optional override. start.sh otherwise creates a private stable credential.
# OPENCODE_SERVER_PASSWORD=

# The defaults below keep all mutable state on the host. Absolute paths are
# recommended when Compose is launched outside this checkout.
# GYMNASIUM_DATA_DIR=/home/you/services/gymnasium/data
# GYMNASIUM_REPORTS_DIR=/home/you/services/gymnasium/reports
# OPENCODE_DATA_DIR=/home/you/.gymnasium-opencode
# CLOUDFLARED_DIR=/home/you/.cloudflared

# Skip the `cloudflared tunnel route dns` step (after the first run, or
# when DNS is managed by hand).
# SKIP_DNS=1
